# Domain yang sudah diarahkan (A record) ke IP VPS. HTTPS diurus otomatis oleh Caddy.
DOMAIN=cloud.contoh.com
BASE_URL=https://cloud.contoh.com

# Buat dengan: openssl rand -hex 32
JWT_SECRET=
ENC_KEY=
POSTGRES_PASSWORD=

# Google Cloud Console > Credentials > OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Ubah ke false setelah akun Anda terdaftar agar orang lain tidak bisa mendaftar
ALLOW_REGISTER=true
# Batas ukuran satu file (MB)
MAX_UPLOAD_MB=2048
