# URL production Anda, tanpa garis miring di akhir (harus sama dengan redirect URI di Google)
BASE_URL=https://nama-proyek.vercel.app

# Otomatis terisi jika memakai integrasi Neon dari Vercel. Isi manual jika memakai Postgres lain.
DATABASE_URL=

# Buat dengan: openssl rand -hex 32
JWT_SECRET=
ENC_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Ubah ke false setelah akun Anda terdaftar
ALLOW_REGISTER=true
